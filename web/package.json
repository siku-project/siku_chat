{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run messages && vite",
    "build": "bun run messages && run-p type-check:only \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "build-only": "vite build",
    "type-check": "bun run messages && bun run type-check:only",
    "type-check:only": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings",
    "messages": "bun run locales && bun run paraglide",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "check": "bun run locales --check && bun run paraglide && bun run format && bun run type-check:only && bun run lint",
    "locales": "node scripts/sync-locales.mjs",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy globalVariable baseLocale --silent",
    "postinstall": "bun run paraglide",
    "lint:siku": "siku check src && siku doctor .",
    "ai:sync": "siku ai sync .."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^3.2.2",
    "@siku/ui": "git+https://github.com/siku-project/siku-ui.git#v1.20.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^26.6.6",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.93.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "npm-run-all2": "^9.0.4",
    "oxlint": "^1.93.0",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "3",
    "typescript": "6",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "axios": "^1.21.1"
  }
}
